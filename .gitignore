# =====================================================================
# eLibrary — static HTML/JS app (no build system). Keep this lean.
# Rule: never commit secrets or real student PII; never commit local tooling junk.
# =====================================================================

# --- SECRETS: must never be published ---
# .mcp.json holds SUPABASE_ACCESS_TOKEN (personal access token)
.mcp.json
# any real env / key files, if ever added later
.env
.env.*
*.key
*.pem
service_role*.txt

# --- LEGACY / not part of the Cloudflare deploy ---
# Google Apps Script clasp id
.clasp.json

# --- LOCAL TOOLING (machine-specific, not the app) ---
.claude/
graphify-out/
*.original.md
.vscode/
.DS_Store
Thumbs.db

# --- OPTIONAL local-only real student seed, if ever extracted out of index.html ---
seed-data.local.js

# --- Node (only if you ever add tooling; app itself needs none) ---
node_modules/
*.log
